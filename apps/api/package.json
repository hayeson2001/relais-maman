{
  "name": "@relais-maman/api",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker/run.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "demo:reset": "tsx --env-file-if-exists=../../.env src/demo/reset.ts",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate >/dev/null && vitest run",
    "build": "prisma generate >/dev/null && tsc --noEmit -p tsconfig.json",
    "demo:totp": "tsx --env-file-if-exists=../../.env src/demo/totp.ts",
    "admin:create": "tsx --env-file-if-exists=../../.env src/admin/createAdmin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@relais-maman/core": "0.2.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
