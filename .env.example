# ─── Environnement ─────────────────────────────────────────────────────────
# local | demo | pilot | production
# La remise à zéro de démonstration n'est autorisée QUE si APP_ENV=demo ou local.
APP_ENV=local
PORT=3000

# ─── Base de données ───────────────────────────────────────────────────────
# npm run db:start (instance isolée, sans mot de passe, écoute locale uniquement)
DATABASE_URL=postgresql://relais@127.0.0.1:54329/relais_maman
TEST_DATABASE_URL=postgresql://relais@127.0.0.1:54329/relais_maman_test
# Avec Docker Compose :
# DATABASE_URL=postgresql://relais:relais-local-only@127.0.0.1:54329/relais_maman

# ─── Sécurité ──────────────────────────────────────────────────────────────
# Secret d'application : openssl rand -hex 32
APP_SECRET=remplacer-par-openssl-rand-hex-32
# Cookies Secure : true obligatoire hors développement local (HTTPS)
COOKIE_SECURE=false

# ─── Pays et fuseau ────────────────────────────────────────────────────────
DEFAULT_COUNTRY=TG

# ─── Stockage audio privé ──────────────────────────────────────────────────
# local : répertoire privé sur disque (jamais servi statiquement)
# s3    : stockage compatible S3 (SeaweedFS en local : docker compose --profile s3 up)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local/audio
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=relais-maman-audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Connecteurs (SMS, voix, transcription, structures) ────────────────────
# simulator : simulateur local (aucun envoi réel). Les connecteurs réels restent
# désactivés tant que leurs identifiants ne sont pas renseignés ET que le connecteur
# n'est pas explicitement activé par un administrateur.
SMS_PROVIDER=simulator
VOICE_PROVIDER=simulator
TRANSCRIPTION_PROVIDER=none
# Secret de signature des webhooks entrants du fournisseur (vérification HMAC)
WEBHOOK_SIGNING_SECRET=remplacer-par-openssl-rand-hex-32
